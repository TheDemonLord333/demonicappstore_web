# =====================================================================
# Demonic App Store – Umgebungskonfiguration
# Kopieren nach ".env" und Werte anpassen. NIEMALS die echte .env committen!
# =====================================================================

# Server
PORT=3009
NODE_ENV=production

# Öffentliche Basis-URL (ohne trailing slash), wird u.a. für Manifest-/Install-Links verwendet
BASE_URL=https://das.thedemonlord333.me

# Datenbank (SQLite-Datei). Für einen späteren Wechsel auf PostgreSQL/MariaDB
# siehe server/database/db.js – die Zugriffsschicht ist dafür gekapselt.
DB_PATH=./data/store.db

# Sessions
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=demonic.sid
# Sitzungsdauer in Stunden
SESSION_TTL_HOURS=12

# Uploads (Werte in MB)
MAX_IPA_SIZE_MB=500
MAX_ICON_SIZE_MB=5
MAX_SCREENSHOT_SIZE_MB=10

# Verzeichnisse (relativ zum Projekt-Root)
UPLOAD_DIR=./uploads

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Trust Proxy (auf "1" setzen, wenn hinter Nginx-Reverse-Proxy)
TRUST_PROXY=1
